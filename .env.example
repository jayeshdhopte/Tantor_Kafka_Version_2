# Database (all three values are required; Compose overrides the URL with its
# private `database` service name.) PostgreSQL 16.14 is digest-pinned.
# Generate a local-only password; do not reuse or commit a real environment secret.
SPRING_PROFILES_ACTIVE=dev
TANTOR_ENVIRONMENT=development
TANTOR_DB_URL=jdbc:postgresql://localhost:5432/tantor
TANTOR_DB_USER=
TANTOR_DB_PASSWORD=

# Artifact repository
TANTOR_REPO_INTERNAL_URL=http://localhost:8081
TANTOR_REPO_PUBLIC_URL=https://localhost:8443
TANTOR_PUBLIC_ORIGIN=https://localhost:8443
TANTOR_REPO_PATH=./.runtime/repository
TANTOR_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security
TANTOR_ENCRYPTION_KEY=
TANTOR_JWT_SECRET=
TANTOR_KEYSTORE_PASSWORD=
TANTOR_TRUSTSTORE_DIR=./.runtime/security/truststores

# Agent-to-backend compatibility. This allows only the dedicated internal and
# external agent endpoints to operate without a client certificate or user JWT.
# Browser APIs remain protected unless the separate UI switch is enabled.
TANTOR_AGENT_LEGACY_UNAUTHENTICATED_ENABLED=true
TANTOR_UI_LEGACY_UNAUTHENTICATED_ENABLED=false

# Keycloak / OIDC backend JWT verification. The issuer must exactly match the
# `iss` claim in Keycloak access tokens. TANTOR_KEYCLOAK_ISSUER_URI is also
# accepted for compatibility with existing deployment files.
TANTOR_OIDC_ISSUER_URI=https://keycloak.example.local/realms/Gatekeeper
TANTOR_OIDC_AUDIENCE=apb-kafka

# Monitoring
TANTOR_MONITORING_MODE=direct
TANTOR_PROMETHEUS_URL=http://127.0.0.1:9090
TANTOR_MONITORING_EXPORTER_HOST=127.0.0.1
TANTOR_KAFKA_EXPORTER_PORT_BASE=9308
TANTOR_JMX_EXPORTER_PORT=7071
TANTOR_CONTROLLER_JMX_EXPORTER_PORT=7072

# Kafka deployment defaults (development only; production must set explicitly)
TANTOR_KAFKA_SECURITY_MODE=PLAINTEXT

# Optional Keycloak frontend auth. Keep false for local development without Keycloak.
VITE_AUTH_ENABLED=false
VITE_KEYCLOAK_URL=https://keycloak.example.local
VITE_KEYCLOAK_REALM=Gatekeeper
VITE_KEYCLOAK_CLIENT_ID=apb-kafka
